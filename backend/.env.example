# Plantilla de variables de entorno para el backend.
# Copia este archivo a "backend/.env" y rellena los valores reales.
# backend/.env está en .gitignore y NUNCA debe subirse al repositorio.

# Clave de OpenAI (Whisper + embeddings + análisis)
OPENAI_API_KEY=sk-...

# Conexión a la base de datos en formato libpq (la que da Neon, con usuario y contraseña).
# El backend la parsea automáticamente: no hace falta separar usuario/contraseña.
DATABASE_URL=postgresql://usuario:password@<host>.neon.tech/neondb?sslmode=require

# Alternativa (solo si NO usas DATABASE_URL): definir por separado
# DB_USERNAME=neondb_owner
# DB_PASSWORD=tu_password
# DB_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require
