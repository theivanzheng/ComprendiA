# Plantilla de variables de entorno para el backend.
# Copia este archivo a "backend/.env" y rellena los valores reales.
# backend/.env está en .gitignore y NUNCA debe subirse al repositorio.

# Clave de OpenAI (Whisper + embeddings + análisis)
OPENAI_API_KEY=sk-...

# Contraseña de la base de datos Neon (la que rotaste; NO va en application.properties)
DB_PASSWORD=tu_password_de_neon

# Opcionales: solo si quieres sobreescribir los valores por defecto de application.properties
# DB_USERNAME=neondb_owner
# DB_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require
